{
  "name": "sproutask",
  "version": "0.4.1",
  "private": true,
  "description": "芽问 SproutAsk —— 运行在 DSH 内核上、本地优先的初中生物学习 Agent",
  "author": "HaoyanZhang123",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --dir education dev",
    "build": "pnpm --dir education build",
    "build:host": "pnpm --dir education build:host",
    "build:payload": "pnpm --dir education build:payload",
    "build:installer": "pnpm --dir education build:installer",
    "build:win": "pnpm --dir education build:win",
    "check:tracked": "pnpm --dir education check:tracked",
    "typecheck": "pnpm --dir education typecheck",
    "test": "pnpm --dir education test",
    "test:task": "pnpm --dir education test:task",
    "test:contracts": "pnpm --dir education test:contracts",
    "content:validate": "pnpm --dir education content:validate",
    "contract:lock:generate": "pnpm --dir education contract:lock:generate",
    "contract:lock:verify": "pnpm --dir education contract:lock:verify",
    "debug:e2e": "node education/scripts/debug/e2e.mjs"
