# 依赖与构建产物（与源码目录同名的规则一律锚定仓库根，避免误伤 src/**/build 之类）
node_modules/
/out/
/dist/
/release/
# 注意：写成 /build/* 而不是 /build/ —— 父目录被整体忽略时，文件级"例外"是无效的
/build/*
# 例外：应用图标是需要长期留存的自有资产（不是构建产物；electron-builder 从这里取）
!/build/icon.ico
/tmp/
__pycache__/
*.pyc

# 环境与密钥
.env
.env.local
.env.*.local

# 不进版本库的本地资料（见 docs/ARCHITECTURE.md 的目录结构一节）
notes/
content/textbook/

# 运行时数据（本地 SQLite / 日志，若放在仓库目录内）
data/
*.log

# 开发期自检产物（SPROUTASK_SELFTEST=1 的界面截图与结果文件）
selftest-*.png
selftest-result.json

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
