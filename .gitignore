# 根目录忽略规则（公开导出仓库从仓库根直接 pnpm install / 构建时生效）
# 说明：education/.gitignore 管 education/ 内部；本文件管仓库根与跨目录产物。

# 依赖
node_modules/

# 本地私有数据（教材原文、密钥、证据都留在 .local，永不进版本库）
education/.local/

# 构建产物
education/dist/
education/coverage/
*.tsbuildinfo

# 教材原文/导出的 PDF（版权材料，绝不入库）
*.pdf

# 环境与密钥（真实 key 只放在 education/.local/secrets/）
.env
.env.local
.env.*.local

# 日志
*.log

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
