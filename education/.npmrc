# Education workspace local pnpm settings (config owner: T01 -> T13 -> T15 -> T16).
# 2026-10-29: pnpm 11 auto-runs `install` before scripts (verify-deps-before-run),
# which silently rewrote education/pnpm-lock.yaml while parallel task owners were
# working. Scoped task commands must be side-effect free, so the automatic
# dependency verification is disabled here; `pnpm --dir education install
# --frozen-lockfile` remains the explicit, serialized lock update step.
verify-deps-before-run=false
