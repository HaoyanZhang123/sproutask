#!/usr/bin/env node
/**
 * A2/T16 鈥?generate the third-party license NOTICE bundle (UTF-8, no BOM).
 *
 * Inputs: T00 license inventory/summary, T16 hoisted payload, supplemented
 * upstream texts, Node.js LICENSE, and the 5A trim decision.
 * Outputs: education/licenses/{NOTICE,THIRD-PARTY-LICENSES,NODEJS-NOTICE,
 * FONTS-NOTICE,NATIVE-BINARIES,EXCLUDED,README}.md + texts/** + data/**.
 *
 * All texts are copied byte-for-byte from upstream files; packages whose
 * tarball has no license text are recorded as "upstream did not provide text".
 */

import { createHash } from 'node:crypto';
import { existsSync, mkdirSync, readFileSync, readdirSync, statSync, writeFileSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const here = path.dirname(fileURLToPath(import.meta.url));
const educationRoot = path.resolve(here, '..', '..');
const licensesRoot = path.join(educationRoot, 'licenses');
const textsRoot = path.join(licensesRoot, 'texts');
const dataRoot = path.join(licensesRoot, 'data');
const hoisted = path.join(educationRoot, '.local', 'cache', 'T16', 'hoisted-test', 'node_modules');
const inventoryPath = path.join(educationRoot, '.local/evidence/T00/run-01/40-licenses/license-inventory.json');
const summaryPath = path.join(educationRoot, '.local/evidence/T00/run-01/40-licenses/license-summary.json');
const missingPath = path.join(dataRoot, 'missing-licenses.json');
const nodeLicensePath = 'resources/runtime/primary-runtime/dependencies/node/LICENSE';
const nodeExePath = 'resources/runtime/primary-runtime/dependencies/node/bin/node.exe';

const TRIM_ROOTS = [
  '@deepseek-ai/libreoffice-kit',
  '@deepseek-ai/libreoffice-kit-win32-x64',
  'sherpa-onnx-node',
  'sherpa-onnx-win-x64',
  'node-pty',
];
const CATEGORY_ORDER = [
  'MIT',
  'Apache-2.0',
  'BSD-3-Clause',
  'BSD-2-Clause',
  'ISC',
  '0BSD',
  'Unlicense',
  'Python-2.0',
  '(MIT OR CC0-1.0)',
  'MPL-2.0',
  'Apache-2.0 AND LGPL-3.0-or-later',
];
const FONT_PACKAGES = ['@deepseek-ai/dsh-client-ui-theme', '@deepseek-ai/dsh-web-frontend'];

const sha256 = (buffer) => createHash('sha256').update(buffer).digest('hex');
const readJson = (file) => JSON.parse(readFileSync(file, 'utf8'));
const rel = (file) => path.relative(educationRoot, file).split(path.sep).join('/');
const pkgDir = (name) => path.join(hoisted, ...name.split('/'));

function walk(dir) {
  const files = [];
  const visit = (current) => {
    for (const entry of readdirSync(current, { withFileTypes: true })) {
      const full = path.join(current, entry.name);
      if (entry.isDirectory()) visit(full);
      else files.push(full);
    }
  };
  visit(dir);
  return files;
}

function readTexts(record) {
  const dir = pkgDir(record.name);
  const texts = [];
  const seen = new Set();
  const add = (file) => {
    const buffer = readFileSync(file);
    texts.push({
      source: `node_modules/${record.name}/${path.relative(dir, file).split(path.sep).join('/')}`,
      sha256: sha256(buffer),
      text: buffer.toString('utf8'),
      buffer,
    });
    seen.add(file);
  };
  for (const file of record.licenseFiles ?? []) {
    const full = path.join(dir, file.file);
    if (existsSync(full)) add(full);
  }
  if (FONT_PACKAGES.includes(record.name)) {
    for (const full of walk(dir)) {
      if (!seen.has(full) && /montserrat.*ofl/i.test(path.basename(full))) add(full);
    }
  }
  return texts;
}

function supplementTexts(name) {
  const base = path.join(textsRoot, 'supplemented');
  if (!existsSync(base)) return [];
  const prefix = `${name.replaceAll('@', '').replaceAll('/', '__')}@`;
  const texts = [];
  for (const dir of readdirSync(base).filter((entry) => entry.startsWith(prefix))) {
    for (const full of walk(path.join(base, dir))) {
      const buffer = readFileSync(full);
      texts.push({
        source: `licenses/texts/supplemented/${path.relative(base, full).split(path.sep).join('/')}`,
        sha256: sha256(buffer),
        text: buffer.toString('utf8'),
        buffer,
      });
    }
  }
  return texts;
}

function copyrightLine(text) {
  const lines = text
    .split(/\r?\n/)
    .map((line) => line.trim())
    .filter((line) => line.length > 0);
  const candidate = lines.find(
    (line) =>
      /copyright|\(c\)\s|漏/i.test(line) &&
      !/\[yyyy\]|\{yyyy\}|<year>|yyyy|name of copyright owner/i.test(line) &&
      !/the above copyright notice|permission is hereby|all copies or substantial|provided that the above/i.test(line),
  );
  return candidate ?? null;
}

function trimClosure(names) {
  const nameSet = new Set(names);
  const deps = new Map();
  const reverse = new Map();
  for (const name of names) {
    const file = path.join(pkgDir(name), 'package.json');
    const list = existsSync(file)
      ? Object.keys({
          ...(readJson(file).dependencies ?? {}),
          ...(readJson(file).optionalDependencies ?? {}),
        }).filter((dep) => nameSet.has(dep))
      : [];
    deps.set(name, list);
    for (const dep of list) reverse.set(dep, [...(reverse.get(dep) ?? []), name]);
  }
  const removed = new Set(TRIM_ROOTS.filter((name) => nameSet.has(name)));
  const queue = [...removed];
  while (queue.length > 0) {
    for (const dep of deps.get(queue.shift()) ?? []) {
      if (!removed.has(dep)) {
        removed.add(dep);
        queue.push(dep);
      }
    }
  }
  let changed = true;
  while (changed) {
    changed = false;
    for (const name of [...removed]) {
      if (TRIM_ROOTS.includes(name)) continue;
      if ((reverse.get(name) ?? []).some((parent) => !removed.has(parent))) {
        removed.delete(name);
        changed = true;
      }
    }
  }
  return removed;
}

function main() {
  const inventory = readJson(inventoryPath);
  const summary = readJson(summaryPath);
  const missing = readJson(missingPath);
  const katexTexts = missing.katex === null ? [] : supplementTexts('katex');
  const missingByName = new Map(missing.packages.map((item) => [item.name, item]));
  const trimmed = trimClosure(inventory.map((record) => record.name));

  mkdirSync(textsRoot, { recursive: true });
  mkdirSync(dataRoot, { recursive: true });

  const entries = inventory.map((record) => {
    const texts = [...readTexts(record), ...supplementTexts(record.name)];
    return {
      name: record.name,
      version: record.version,
      license: record.license ?? 'UNKNOWN',
      official: record.official === true,
      ships: trimmed.has(record.name) ? 'no (5A trim)' : 'yes',
      texts,
      copyright: texts.length === 0 ? null : copyrightLine(texts[0].text),
      missingInfo: missingByName.get(record.name) ?? null,
      binaryAssets: record.binaryAssets ?? [],
    };
  });

  const unique = new Map();
  for (const texts of [...entries.map((entry) => entry.texts), katexTexts]) {
    for (const text of texts) {
      const bucket = unique.get(text.sha256) ?? { sha256: text.sha256, buffer: text.buffer, sources: [] };
      bucket.sources.push(text.source);
      unique.set(text.sha256, bucket);
    }
  }
  const textIndex = [];
  for (const item of [...unique.values()].sort((a, b) => (a.sha256 < b.sha256 ? -1 : 1))) {
    const file = path.join(textsRoot, `${item.sha256.slice(0, 16)}.txt`);
    writeFileSync(file, item.buffer);
    textIndex.push({
      file: rel(file),
      localFile: `texts/${item.sha256.slice(0, 16)}.txt`,
      sha256: item.sha256,
      bytes: item.buffer.byteLength,
      sources: item.sources,
    });
  }
  const byHash = new Map(textIndex.map((item) => [item.sha256, item]));

  let node = null;
  if (existsSync(nodeLicensePath)) {
    const buffer = readFileSync(nodeLicensePath);
    const file = path.join(textsRoot, 'nodejs-LICENSE.txt');
    writeFileSync(file, buffer);
    node = {
      source: nodeLicensePath,
      file: rel(file),
      localFile: 'texts/nodejs-LICENSE.txt',
      sha256: sha256(buffer),
      bytes: buffer.byteLength,
      exe: existsSync(nodeExePath)
        ? { path: nodeExePath, bytes: statSync(nodeExePath).size, sha256: sha256(readFileSync(nodeExePath)) }
        : null,
    };
  }

  const fonts = [];
  for (const name of FONT_PACKAGES) {
    const dir = pkgDir(name);
    for (const file of walk(dir)) {
      if (!/\.(woff2?|ttf|otf)$/i.test(path.basename(file))) continue;
      const buffer = readFileSync(file);
      fonts.push({
        package: name,
        path: path.relative(dir, file).split(path.sep).join('/'),
        bytes: buffer.byteLength,
        sha256: sha256(buffer),
        family: /montserrat/i.test(path.basename(file)) ? 'Montserrat' : /katex/i.test(path.basename(file)) ? 'KaTeX' : 'other',
      });
    }
  }

  const binaries = [];
  for (const entry of entries) {
    if (entry.binaryAssets.length === 0) continue;
    binaries.push({
      name: entry.name,
      version: entry.version,
      license: entry.license,
      ships: entry.ships,
      files: entry.binaryAssets.map((asset) => {
        const full = path.join(pkgDir(entry.name), asset);
        if (!existsSync(full)) return { path: asset.split(path.sep).join('/'), present: false };
        const buffer = readFileSync(full);
        return { path: asset.split(path.sep).join('/'), present: true, bytes: buffer.byteLength, sha256: sha256(buffer) };
      }),
    });
  }

  const generatedAt = new Date().toISOString();
  const manifest = {
    generatedAt,
    inventory: { path: rel(inventoryPath), sha256: sha256(readFileSync(inventoryPath)), packages: inventory.length },
    packageCount: entries.length,
    officialPackages: summary.officialPackages,
    thirdPartyPackages: summary.thirdPartyPackages,
    uniqueLicenseTexts: textIndex.length,
    missingLicenseTextCount: summary.packagesWithoutLicenseFile.length,
    supplementedCount: entries.filter((entry) => entry.missingInfo?.status === 'supplemented').length,
    upstreamAbsentCount: entries.filter((entry) => entry.missingInfo?.status === 'absent-in-tarball').length,
    trimRoots: TRIM_ROOTS,
    trimmedApproxClosure: trimmed.size,
    node,
    katex:
      katexTexts[0] === undefined
        ? null
        : { version: missing.katex.version, sha256: katexTexts[0].sha256, file: byHash.get(katexTexts[0].sha256)?.file ?? null },
    fonts,
    binaries,
  };
  writeFileSync(path.join(dataRoot, 'license-manifest.json'), `${JSON.stringify(manifest, null, 2)}\n`, 'utf8');
  writeFileSync(path.join(dataRoot, 'license-text-index.json'), `${JSON.stringify(textIndex, null, 2)}\n`, 'utf8');

  /* NOTICE.md */
  const grouped = new Map();
  for (const entry of entries) grouped.set(entry.license, [...(grouped.get(entry.license) ?? []), entry]);
  const categories = [
    ...CATEGORY_ORDER.filter((category) => grouped.has(category)),
    ...[...grouped.keys()].filter((category) => !CATEGORY_ORDER.includes(category)).sort(),
  ];
  const notice = [
    '# 绗笁鏂硅鍙?NOTICE锛圱hird-Party Notices锛?,
    '',
    `鐢熸垚鏃堕棿锛?{generatedAt}锛堟満鍣ㄧ敓鎴愶紱涓嶆槸娉曞緥鎰忚锛塦,
    '',
    '鏈枃浠惰鐩?DSH 鍥哄畾 npm 闂寘锛坄@deepseek-ai/dsh@0.2.1-rc.3`锛夌殑 558 涓寘锛?06 瀹樻柟 / 252 绗笁鏂癸級锛屼互鍙婂皢闅?Windows 浜х墿鍒嗗彂鐨?Node.js 杩愯鏃躲€?,
    '',
    '**5A 瑁佸壀璇存槑**锛氱敤鎴峰凡鎵瑰噯鍘绘帀 office / speech / PTY / sharp 缁勪欢銆俙闅忓寘` 鍒楋細`yes` = 涓ょ褰㈡€侀兘闅忓寘锛沗no (5A trim)` = 浠呭瓨鍦ㄤ簬褰撳墠鍏ㄩ噺闂寘锛岃鍓悗涓嶉殢瀛︾敓鍖呭垎鍙戯紙鍩轰簬 package.json 渚濊禆闂寘鐨勮繎浼煎垽鏂紝鏈€缁堜互鎵撳寘娓呭崟涓哄噯锛夈€?,
    '',
    '姣忎釜鍖呯殑瀹屾暣璁稿彲鏂囨湰瑙?`THIRD-PARTY-LICENSES.md`锛坄texts/<sha256鍓?6浣?.txt`锛屾寜鍐呭鍘婚噸锛夈€傜己涓婃父鏂囨湰鐨勫寘鍗曠嫭鍒楀嚭锛屼笉缂栭€犺鍙枃鏈€?,
    '',
    '## 1. 鍖呮竻鍗曪紙鎸夎鍙垎缁勶級',
    '',
  ];
  for (const category of categories) {
    const list = grouped.get(category).sort((a, b) => a.name.localeCompare(b.name));
    notice.push(`### ${category}锛?{list.length} 鍖咃級`, '', '| 鍖呭悕 | 鐗堟湰 | 璁稿彲 | 鐗堟潈琛?| 闅忓寘 | 鏂囨湰 |', '|---|---|---|---|---|---|');
    for (const entry of list) {
      const textCell =
        entry.texts.length === 0
          ? '涓婃父鏈彁渚涙枃鏈紙瑙?搂2锛?
          : [...new Set(entry.texts.map((text) => byHash.get(text.sha256).localFile))]
              .map((file) => `[${path.basename(file)}](${file})`)
              .join('<br>');
      notice.push(`| \`${entry.name}\` | ${entry.version} | ${entry.license} | ${entry.copyright ?? '瑙佽鍙叏鏂?} | ${entry.ships} | ${textCell} |`);
    }
    notice.push('');
  }
  notice.push('## 2. 18 涓己璁稿彲鏂囨湰鍖呯殑澶勭悊缁撴灉', '');
  notice.push(
    '鏉ユ簮锛歍00 `license-summary.json` 鐨?`packagesWithoutLicenseFile`銆傚鐞嗘柟寮忥細涓嬭浇瀵瑰簲绮剧‘鐗堟湰 tarball 鍒?`.local/cache/T16/tarballs`锛堜笉杩?Git锛夛紝瑙ｅ寘鏌ユ壘 `LICENSE/COPYING/NOTICE`銆?,
    '',
    '| 鍖呭悕 | 鐗堟湰 | 璁稿彲 | tarball 鏂囨湰 | 澶勭悊缁撴灉 |',
    '|---|---|---|---|---|',
  );
  for (const label of summary.packagesWithoutLicenseFile) {
    const name = label.includes('@') ? label.slice(0, label.lastIndexOf('@')) : label;
    const entry = entries.find((item) => item.name === name);
    const info = missingByName.get(name);
    const textCell =
      entry === undefined || entry.texts.length === 0
        ? '鈥?
        : [...new Set(entry.texts.map((text) => byHash.get(text.sha256).localFile))]
            .map((file) => `[${path.basename(file)}](${file})`)
            .join('<br>');
    const status =
      info?.status === 'supplemented' ? '宸茶ˉ鍏? : info?.status === 'absent-in-tarball' ? '涓婃父鏈彁渚涙枃鏈? : (info?.status ?? '鏈鐞?);
    notice.push(
      `| \`${name}\` | ${entry?.version ?? '?'} | ${entry?.license ?? '?'} | ${textCell} | ${status}${info?.registryUrl === undefined ? '' : `锛?{info.registryUrl}锛塦} |`,
    );
  }
  notice.push(
    '',
    '瀵逛簬鈥滀笂娓告湭鎻愪緵鏂囨湰鈥濈殑 17 涓寘锛歯pm tarball 鍐呭彧鏈?`license` 瀛楁澹版槑锛屾病鏈夎鍙叏鏂囥€傛湰 NOTICE 涓嶅鍒跺叾浠栭」鐩枃鏈紝涔熶笉鎶?SPDX 鏍囪瘑褰撲綔鏂囨湰銆傚垎鍙戝墠搴旓細鈶犲悜涓婃父浠撳簱鍙栧緱璇ョ増鏈?LICENSE 鍏ㄦ枃锛涒憽鎴栨浛鎹㈣渚濊禆锛涒憿鍙栧緱鏂囨湰鍓嶄笉寰楀０绉拌鍖呰鍙叏鏂囧凡闅忓寘銆?,
    '',
    '## 3. 鍒嗗彂涔夊姟鎽樿',
    '',
    '- MIT / ISC / BSD-2 / BSD-3 / 0BSD / Unlicense锛氫繚鐣欑増鏉冨０鏄庝笌璁稿彲鍏ㄦ枃锛圔SD-3 鍙﹀惈涓嶅緱鑳屼功鏉℃锛夈€?,
    '- Apache-2.0锛氶檮 LICENSE锛涘寘鍐呭鏈?NOTICE 涓€骞朵繚鐣欍€?,
    '- MPL-2.0锛坙ibreoffice-kit 涓ゅ寘锛屽凡瑁佸壀锛夛細濡傛仮澶嶅垎鍙戯紝闇€闄?MPL 鍏ㄦ枃涓?NOTICE锛屽苟鎻愪緵瀵瑰簲婧愮爜鑾峰彇鏂瑰紡銆?,
    '- LGPL-3.0-or-later锛坰harp/libvips锛屽凡瑁佸壀锛夛細濡傛仮澶嶅垎鍙戯紝闇€闄?LGPL 鏂囨湰銆佸厑璁告浛鎹㈠簱骞舵彁渚涙簮鐮佽幏鍙栨柟寮忋€?,
    '- 瀛椾綋锛歁ontserrat OFL-1.1銆並aTeX MIT锛岃 `FONTS-NOTICE.md`銆?,
    '- Node.js锛歁IT + bundled notices锛岃 `NODEJS-NOTICE.md`銆?,
    '- 鏈」鐩嚜鏈変唬鐮佸綋鍓嶄负绉佹湁/UNLICENSED锛涗骇鍝佸寲璁稿彲鐢辩敤鎴峰喅瀹氥€?,
    '',
  );
  writeFileSync(path.join(licensesRoot, 'NOTICE.md'), `${notice.join('\n')}\n`, 'utf8');

  /* THIRD-PARTY-LICENSES.md */
  const indexDoc = [
    '# 绗笁鏂硅鍙叏鏂囩储寮曪紙Third-Party License Texts锛?,
    '',
    `鐢熸垚鏃堕棿锛?{generatedAt}锛涘叡 ${textIndex.length} 浠藉幓閲嶆枃鏈€?{entries.length} 涓寘銆傛枃浠跺悕 = 鍐呭 SHA-256 鍓?16 浣嶃€俙,
    '',
    '## 鏂囨湰鏂囦欢',
    '',
    '| 鏂囨湰鏂囦欢 | SHA-256 | 瀛楄妭 | 寮曠敤鍖呮暟 |',
    '|---|---|---|---|',
  ];
  for (const item of textIndex) {
    const count = entries.filter((entry) => entry.texts.some((text) => text.sha256 === item.sha256)).length;
    indexDoc.push(`| [${path.basename(item.localFile)}](${item.localFile}) | \`${item.sha256}\` | ${item.bytes} | ${count} |`);
  }
  indexDoc.push('', '## 鍖?鈫?鏂囨湰鏄犲皠', '', '| 鍖?| 鐗堟湰 | 璁稿彲 | 鏂囨湰鏂囦欢锛堝幓閲嶏級 |', '|---|---|---|---|');
  for (const entry of [...entries].sort((a, b) => a.name.localeCompare(b.name))) {
    const files =
      entry.texts.length === 0
        ? '涓婃父鏈彁渚涙枃鏈?
        : [...new Set(entry.texts.map((text) => byHash.get(text.sha256).localFile))]
            .map((file) => `[${path.basename(file)}](${file})`)
            .join('<br>');
    indexDoc.push(`| \`${entry.name}\` | ${entry.version} | ${entry.license} | ${files} |`);
  }
  writeFileSync(path.join(licensesRoot, 'THIRD-PARTY-LICENSES.md'), `${indexDoc.join('\n')}\n`, 'utf8');

  /* NODEJS-NOTICE.md */
  const nodeDoc = [
    '# Node.js 杩愯鏃惰鍙笌绗笁鏂瑰０鏄?,
    '',
    'Windows 浜х墿灏嗚嚜甯?Node.js 杩愯鏃讹紙`app/node/node.exe`锛夛紱鎸?Node.js 鍒嗗彂瑕佹眰淇濈暀鍏?LICENSE锛堝惈 bundled third-party notices锛夈€?,
    '',
  ];
  if (node === null) {
    nodeDoc.push('**BLOCKED**锛氭湭鎵惧埌 Node.js 鍙戣鍖?LICENSE锛屾湭鐢熸垚鏂囨湰锛涢渶浠庢渶缁堥殢鍖?node.exe 鍚岀洰褰曞鍒?LICENSE銆?);
  } else {
    nodeDoc.push(
      `- 婧愭枃浠讹細\`${node.source}\``,
      `- 宸叉敹褰曞叏鏂囷細[${node.localFile}](${node.localFile})锛圫HA-256 \`${node.sha256}\`锛?{node.bytes} B锛塦,
      node.exe === null
        ? '- 瀵瑰簲 node.exe锛氭湭鎵惧埌'
        : `- 瀵瑰簲 node.exe锛歕`${node.exe.path}\`锛?{node.exe.bytes} B锛孲HA-256 \`${node.exe.sha256}\`锛夛紱鐗堟湰鐢辨闈㈣繍琛屾椂娓呭崟澹版槑涓?v24.21.0銆俙,
      '',
      '## 鏂囨湰鍐呭璇存槑',
