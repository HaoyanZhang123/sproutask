    {
      "schemaVersion": 1,
      "id": "concept.bio7a.observation.meaning",
      "courseEditionId": "course.biology-7a",
      "title": "观察的含义与地位",
      "aliases": [
        "什么是观察",
        "观察的含义"
      ],
      "placements": [
        "toc.bio7a.u1.ch1.s1"
      ],
      "learningObjectives": [
        "能用“有目的、有计划地仔细察看”说明什么是观察，并把它与随意看看区分开",
        "能说出观察是学习生物学的基本方法之一，也是科学探究获取事实的重要途径"
      ],
      "explanation": "观察是带着明确目的、按事先想好的安排去仔细察看事物的活动；它不同于随意浏览，也不同于路过时看一眼。观察既可以直接用眼睛，也能用放大镜、显微镜、望远镜等工具把细小结构看清楚，并常常需要边看边记录、边想问题。观察是学习生物学最基本的方法之一，也是科学探究中获取事实的重要途径。",
      "misconceptions": [
        {
          "statement": "看过就等于观察过",
          "correction": "观察需要明确目的和计划，并伴随记录与思考；路过时随便看一眼不构成一次观察。",
          "sourceRefs": [
            "source.bio7a.c1.not-casual",
            "source.bio7a.c1.purpose-plan"
          ]
        },
        {
          "statement": "观察只能用眼睛，不能用工具",
          "correction": "借助放大镜、显微镜或望远镜等工具，可以扩大观察范围或看清更小的结构；有时还要配合测量，工具不会改变观察的基本要求。",
          "sourceRefs": [
            "source.bio7a.c5.tools",
            "source.bio7a.c5.devices"
          ]
        }
      ],
