    {
      "schemaVersion": 1,
      "id": "concept.bio7a.observation.purpose-object",
      "courseEditionId": "course.biology-7a",
      "title": "观察的目的与对象",
      "aliases": [
        "观察目的",
        "观察对象"
      ],
      "placements": [
        "toc.bio7a.u1.ch1.s1"
      ],
      "learningObjectives": [
        "能针对一个具体的观察任务写出观察目的",
        "能明确观察对象并列出至少两项可观察的具体内容"
      ],
      "explanation": "观察前要先想清楚两件事：为什么观察（目的）和观察谁（对象）。目的可以是了解某种生物的形态结构、生活环境或生活习性，也可以是比较不同生物的异同；目的不同，需要看的内容也不同。对象明确后，还要把它拆成看得见、比得出的具体项目：观察植物多关注植株高度、形态和生长环境，观察动物多关注形态特点、运动方式和栖息环境。",
      "misconceptions": [
        {
          "statement": "观察目的写得越大越好",
          "correction": "目的要具体到能指导看什么，例如“比较两棵树的叶形和树皮”比“了解树”更能指导观察。",
          "sourceRefs": [
            "source.bio7a.c2.purpose-examples"
          ]
        },
        {
          "statement": "观察对象是“生物”，不用再具体",
          "correction": "对象要具体到某种生物及其可观察的项目，否则容易漏看或看得随意。",
          "sourceRefs": [
            "source.bio7a.c2.object",
            "source.bio7a.c2.plant-focus"
          ]
        }
      ],
